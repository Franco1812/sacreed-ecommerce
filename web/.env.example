# API NestJS (api/) — server-only, nunca se llama desde el browser.
API_URL="http://localhost:4000"

# Header secreto para los endpoints de admin de la API. Mismo valor que
# INTERNAL_API_KEY en api/.env.
INTERNAL_API_KEY="[RANDOM-STRING]"

# Admin de Cintia (/admin) — contraseña única, sin gestión de usuarios.
ADMIN_PASSWORD="[CONTRASEÑA]"
ADMIN_SESSION_SECRET="[RANDOM-STRING]"

# Supabase — Storage (fotos de producto). Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-PUBLIC-KEY]"
