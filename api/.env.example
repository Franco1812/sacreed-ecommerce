# Postgres — en dev/pruebas, la connection string de tu proyecto Supabase
# (Supabase → Project Settings → Database → Connection string → "URI",
# elegí el modo "Transaction" / pooled si vas a correr en serverless, o
# "Session" para uso normal desde tu máquina).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

PORT=4000

# Storage de Supabase (fotos de producto/combo) — bucket público "productos".
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[SECRET-KEY]"

# Header secreto que debe mandar web/ para poder llamar a los endpoints del
# admin. Mismo valor que INTERNAL_API_KEY en web/.env.
INTERNAL_API_KEY="[RANDOM-STRING]"
